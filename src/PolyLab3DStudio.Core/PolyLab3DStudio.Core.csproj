<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- LogicalName keeps the flat manifest name GlossaryCatalog looks up
         (PolyLab3DStudio.Core.Glossary.xml) now that the file lives in Reference\. -->
    <EmbeddedResource Include="Reference\Glossary.xml" LogicalName="PolyLab3DStudio.Core.Glossary.xml" />
  </ItemGroup>

</Project>
