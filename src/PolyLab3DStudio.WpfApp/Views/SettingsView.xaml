<UserControl
    x:Class="PolyLab3DStudio.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Padding="28,0"
            Background="{StaticResource HeaderBrush}"
            BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button
                    VerticalAlignment="Center"
                    AutomationProperties.Name="뒤로"
                    Command="{Binding BackCommand}"
                    Style="{StaticResource BackButton}" />
                <TextBlock
                    Margin="14,0,0,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource ScreenTitleText}"
                    Text="설정" />
                <TextBlock
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource MonoMutedText}"
                    Text="SETTINGS"
                    Visibility="{Binding Shell.EnglishOn, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="560" Margin="24,28,24,56">
                <Border
                    Padding="20,6"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderCardBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                    <StackPanel>
                        <Border
                            Padding="0,15"
                            BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="영어 병기 표시" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="12"
                                        Foreground="{StaticResource MutedBrush}"
                                        Text="용어를 영어와 함께 보여줘요. 다른 도구로 갈 때 도움이 됩니다."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleButton
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding Shell.EnglishOn}"
                                    Style="{StaticResource ToggleSwitch}" />
                            </Grid>
                        </Border>
                        <Border
                            Padding="0,15"
                            BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="바닥 그리드 표시" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="12"
                                        Foreground="{StaticResource MutedBrush}"
                                        Text="뷰포트의 격자 무늬 바닥을 켜고 끕니다."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleButton
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding Shell.GridOn}"
                                    Style="{StaticResource ToggleSwitch}" />
                            </Grid>
                        </Border>
                        <Border
                            Padding="0,15"
                            BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="휠 방향 반전" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="12"
                                        Foreground="{StaticResource MutedBrush}"
                                        Text="확대/축소 방향을 반대로 바꿉니다."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleButton
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding Shell.InvertZoom}"
                                    Style="{StaticResource ToggleSwitch}" />
                            </Grid>
                        </Border>
                        <Grid Margin="0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="170" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Text="마우스 감도" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="12"
                                    Foreground="{StaticResource MutedBrush}"
                                    Text="카메라 회전 속도를 조절해요."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="28" />
                                </Grid.ColumnDefinitions>
                                <Slider
                                    VerticalAlignment="Center"
                                    IsSnapToTickEnabled="True"
                                    Maximum="2"
                                    Minimum="0.5"
                                    Style="{StaticResource AccentSlider}"
                                    TickFrequency="0.1"
                                    Value="{Binding Shell.Sensitivity}" />
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource MonoFont}"
                                    FontSize="11"
                                    Foreground="{StaticResource BodyBrush}"
                                    Text="{Binding Shell.SensitivityLabel}"
                                    TextAlignment="Right" />
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border
                    Margin="0,14,0,0"
                    Padding="20,16"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderCardBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="학습 기록 초기화" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="12"
                                Foreground="{StaticResource MutedBrush}"
                                Text="레슨·퀴즈 진행 상황을 처음 상태로 되돌립니다."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Command="{Binding ResetProgressCommand}"
                            Content="초기화"
                            Cursor="Hand"
                            Focusable="False"
                            FontSize="12.5"
                            FontWeight="SemiBold">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="Chrome"
                                        Padding="14,8"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource DangerBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9">
                                        <TextBlock Foreground="{StaticResource DangerBrush}" Text="초기화" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentTintBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!--  환경 점검: which external tools 코스 00 / 트랙 C need, and whether they are here  -->
                <Border
                    Margin="0,16,0,0"
                    Padding="20,6,20,16"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderCardBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                    <StackPanel>
                        <Grid Margin="0,12,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="환경 점검" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource MonoMutedText}"
                                        Text="ENVIRONMENT CHECK" />
                                </StackPanel>
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="12"
                                    Foreground="{StaticResource MutedBrush}"
                                    TextWrapping="Wrap">
                                    <Run Text="{Binding ToolsSummary, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ToolsCheckedAt, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Padding="14,8"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="환경 점검 다시 확인"
                                Command="{Binding RefreshToolsCommand}"
                                Content="다시 확인"
                                FontSize="12.5"
                                Style="{StaticResource GhostButton}" />
                        </Grid>

                        <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Tools}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="0,13"
                                        BorderBrush="{StaticResource DividerBrush}"
                                        BorderThickness="0,1,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        FontSize="13.5"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding Name}" />
                                                    <TextBlock
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource MonoMutedText}"
                                                        Text="{Binding English}" />
                                                </StackPanel>
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    FontSize="11.5"
                                                    Foreground="{StaticResource MutedBrush}"
                                                    Text="{Binding When}" />
                                                <TextBlock
                                                    Margin="0,5,0,0"
                                                    FontSize="11.5"
                                                    Foreground="{StaticResource BodyBrush}"
                                                    Text="{Binding Detail}"
                                                    TextWrapping="Wrap" />
                                                <Border
                                                    x:Name="InstallBox"
                                                    Margin="0,7,12,0"
                                                    Padding="10,7"
                                                    Background="{StaticResource FaintBrush}"
                                                    CornerRadius="7">
                                                    <TextBlock
                                                        FontFamily="{StaticResource MonoFont}"
                                                        FontSize="11"
                                                        Foreground="{StaticResource InkSoftBrush}"
                                                        Text="{Binding Install}"
                                                        TextWrapping="Wrap" />
                                                </Border>
                                            </StackPanel>
                                            <Border
                                                x:Name="Badge"
                                                Grid.Column="1"
                                                Margin="10,1,0,0"
                                                Padding="10,4"
                                                VerticalAlignment="Top"
                                                Background="{StaticResource DangerBorderBrush}"
                                                CornerRadius="7">
                                                <TextBlock
                                                    x:Name="BadgeText"
                                                    FontSize="11"
                                                    FontWeight="Bold"
                                                    Foreground="{StaticResource DangerBrush}"
                                                    Text="{Binding StateLabel}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsFound}" Value="True">
                                            <Setter TargetName="Badge" Property="Background" Value="{StaticResource GreenTintBrush}" />
                                            <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource GreenBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock
                            Margin="0,14,0,0"
                            FontSize="11.5"
                            Foreground="{StaticResource MutedBrush}"
                            Text="찾지 못했다고 나와도 포터블(무설치) 버전이나 다른 경로에 설치된 경우가 있어요. 설치 후에는 [다시 확인]을 누르세요."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
