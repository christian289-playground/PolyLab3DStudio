<UserControl
    x:Class="PolyLab3DStudio.Views.CoursesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PolyLab3DStudio.Controls"
    xmlns:vm="clr-namespace:PolyLab3DStudio.ViewModels;assembly=PolyLab3DStudio.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Border
            Padding="28,0"
            Background="{StaticResource HeaderBrush}"
            BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    VerticalAlignment="Center"
                    AutomationProperties.Name="뒤로"
                    Command="{Binding GoStartCommand}"
                    Style="{StaticResource BackButton}" />
                <StackPanel
                    Grid.Column="1"
                    Margin="14,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ScreenTitleText}" Text="학습 코스" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource MonoMutedText}"
                        Text="COURSES"
                        Visibility="{Binding Shell.EnglishOn, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <StackPanel
                    Grid.Column="3"
                    Margin="0,0,14,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <ProgressBar
                        Width="140"
                        Height="5"
                        VerticalAlignment="Center"
                        Style="{StaticResource AccentProgress}"
                        Value="{Binding Shell.OverallPct, Mode=OneWay}" />
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource MonoFont}"
                        FontSize="11"
                        Foreground="{StaticResource BodyBrush}"
                        Text="{Binding Shell.ProgressText}" />
                </StackPanel>
                <Button
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    Command="{Binding GoStudioFreeCommand}"
                    Content="자유 모드"
                    Style="{StaticResource DarkButton}" />
            </Grid>
        </Border>

        <!--  Course cards  -->
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl
                MaxWidth="880"
                Margin="24,28,24,56"
                ItemsSource="{Binding Courses}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CourseRowViewModel}">
                        <Border
                            Margin="0,0,0,18"
                            Padding="22,20"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderCardBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Padding="8,4"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource AccentTintBrush}"
                                        CornerRadius="7">
                                        <TextBlock
                                            FontFamily="{StaticResource MonoFont}"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource AccentBrush}"
                                            Text="{Binding Num}" />
                                    </Border>
                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="14,0"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="16.5"
                                            FontWeight="Bold"
                                            Text="{Binding Title}" />
                                        <TextBlock
                                            Margin="0,1,0,0"
                                            FontFamily="{StaticResource MonoFont}"
                                            FontSize="10.5"
                                            Foreground="{StaticResource MutedBrush}"
                                            Text="{Binding English}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding English}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontFamily="{StaticResource MonoFont}"
                                            FontSize="11"
                                            Foreground="{StaticResource BodyBrush}"
                                            Text="{Binding ProgressLabel}" />
                                        <ProgressBar
                                            Width="120"
                                            Height="5"
                                            Margin="0,5,0,0"
                                            Background="{StaticResource TrackSoftBrush}"
                                            Style="{StaticResource AccentProgress}"
                                            Value="{Binding Pct, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock
                                    Margin="0,13,0,0"
                                    FontSize="13"
                                    Foreground="{StaticResource BodyBrush}"
                                    LineHeight="20.8"
                                    LineStackingStrategy="BlockLineHeight"
                                    Text="{Binding Description}"
                                    TextWrapping="Wrap" />
                                <Border
                                    Margin="0,13,0,0"
                                    BorderBrush="{StaticResource DividerBrush}"
                                    BorderThickness="0,1,0,0">
                                    <ItemsControl ItemsSource="{Binding Lessons}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:LessonRowViewModel}">
                                                <Button
                                                    AutomationProperties.Name="{Binding Title}"
                                                    Command="{Binding StartCommand}"
                                                    Cursor="Hand"
                                                    Focusable="False">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border
                                                                x:Name="Row"
                                                                Padding="6,11"
                                                                Background="Transparent"
                                                                BorderBrush="{StaticResource DividerBrush}"
                                                                BorderThickness="0,0,0,1"
                                                                CornerRadius="8">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid
                                                                        Width="24"
                                                                        Height="24"
                                                                        VerticalAlignment="Center">
                                                                        <Ellipse
                                                                            x:Name="StCircle"
                                                                            Fill="{StaticResource SurfaceBrush}"
                                                                            Stroke="{StaticResource KnobBrush}"
                                                                            StrokeThickness="1.5" />
                                                                        <TextBlock
                                                                            x:Name="StGlyph"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            FontSize="12"
                                                                            FontWeight="SemiBold"
                                                                            Foreground="{StaticResource MutedBrush}"
                                                                            Text="{Binding Glyph}" />
                                                                    </Grid>
                                                                    <Border
                                                                        x:Name="KindBadge"
                                                                        Grid.Column="1"
                                                                        Margin="12,0,0,0"
                                                                        Padding="8,3"
                                                                        VerticalAlignment="Center"
                                                                        Background="{StaticResource LessonTintBrush}"
                                                                        CornerRadius="6">
                                                                        <TextBlock
                                                                            x:Name="KindText"
                                                                            FontSize="11"
                                                                            FontWeight="SemiBold"
                                                                            Foreground="{StaticResource BodyBrush}"
                                                                            Text="{Binding KindLabel}" />
                                                                    </Border>
                                                                    <StackPanel
                                                                        Grid.Column="2"
                                                                        Margin="12,0,0,0"
                                                                        VerticalAlignment="Center"
                                                                        Orientation="Horizontal">
                                                                        <TextBlock
                                                                            FontSize="13.5"
                                                                            FontWeight="Medium"
                                                                            Text="{Binding Title}" />
                                                                        <TextBlock
                                                                            Margin="8,0,0,0"
                                                                            VerticalAlignment="Center"
                                                                            FontFamily="{StaticResource MonoFont}"
                                                                            FontSize="10"
                                                                            Foreground="{StaticResource MutedBrush}"
                                                                            Text="{Binding English}">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding English}" Value="">
                                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                    <TextBlock
                                                                        Grid.Column="3"
                                                                        Margin="12,0,0,0"
                                                                        VerticalAlignment="Center"
                                                                        FontFamily="{StaticResource MonoFont}"
                                                                        FontSize="11"
                                                                        Foreground="{StaticResource MutedBrush}"
                                                                        Text="{Binding Minutes}" />
                                                                    <TextBlock
                                                                        x:Name="Cta"
                                                                        Grid.Column="4"
                                                                        Margin="12,0,0,0"
                                                                        VerticalAlignment="Center"
                                                                        FontSize="12"
                                                                        FontWeight="SemiBold"
                                                                        Foreground="{StaticResource AccentBrush}"
                                                                        Text="{Binding Cta}" />
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource HeaderBrush}" />
                                                                </Trigger>
                                                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                    <Setter TargetName="StCircle" Property="Fill" Value="{StaticResource GreenBrush}" />
                                                                    <Setter TargetName="StCircle" Property="Stroke" Value="{StaticResource GreenBrush}" />
                                                                    <Setter TargetName="StGlyph" Property="Foreground" Value="{StaticResource SurfaceBrush}" />
                                                                    <Setter TargetName="Cta" Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding KindLabel}" Value="미션">
                                                                    <Setter TargetName="KindBadge" Property="Background" Value="{StaticResource MissionTintBrush}" />
                                                                    <Setter TargetName="KindText" Property="Foreground" Value="{StaticResource MissionFgBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding KindLabel}" Value="퀴즈">
                                                                    <Setter TargetName="KindBadge" Property="Background" Value="{StaticResource GreenTintBrush}" />
                                                                    <Setter TargetName="KindText" Property="Foreground" Value="{StaticResource GreenBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding KindLabel}" Value="이론">
                                                                    <Setter TargetName="KindBadge" Property="Background" Value="{StaticResource IndigoTintBrush}" />
                                                                    <Setter TargetName="KindText" Property="Foreground" Value="{StaticResource IndigoBrush}" />
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!--  Quiz modal  -->
        <Grid
            Grid.RowSpan="2"
            Background="{StaticResource OverlayBrush}"
            Visibility="{Binding ActiveQuiz, Converter={StaticResource NotNullToVisibility}}">
            <Border
                Width="520"
                MaxWidth="700"
                Padding="24,22"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="16"
                DataContext="{Binding ActiveQuiz}">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="64"
                        Direction="270"
                        Opacity="0.4"
                        ShadowDepth="24"
                        Color="{StaticResource ShadowColor}" />
                </Border.Effect>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Padding="8,3"
                            VerticalAlignment="Center"
                            Background="{StaticResource GreenTintBrush}"
                            CornerRadius="6">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource GreenBrush}"
                                Text="퀴즈" />
                        </Border>
                        <TextBlock
                            Grid.Column="1"
                            Margin="10,0"
                            VerticalAlignment="Center"
                            FontSize="15"
                            FontWeight="Bold"
                            Text="{Binding Title}" />
                        <Button
                            Grid.Column="2"
                            AutomationProperties.Name="퀴즈 닫기"
                            Command="{Binding CloseCommand}"
                            Style="{StaticResource CloseButton}" />
                    </Grid>

                    <!--  Active question  -->
                    <StackPanel Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            Margin="0,15,0,0"
                            FontFamily="{StaticResource MonoFont}"
                            FontSize="11"
                            Foreground="{StaticResource MutedBrush}"
                            Text="{Binding Counter}" />
                        <TextBlock
                            Margin="0,15,0,0"
                            FontSize="17"
                            FontWeight="Bold"
                            LineHeight="25.5"
                            LineStackingStrategy="BlockLineHeight"
                            Text="{Binding QuestionText}"
                            TextWrapping="Wrap" />
                        <ItemsControl Margin="0,15,0,0" ItemsSource="{Binding Options}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:QuizOptionViewModel}">
                                    <Button
                                        Margin="0,0,0,8"
                                        AutomationProperties.Name="{Binding Label}"
                                        Command="{Binding PickCommand}"
                                        Cursor="Hand"
                                        Focusable="False">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border
                                                    x:Name="Chrome"
                                                    Padding="14,11"
                                                    Background="{StaticResource SurfaceBrush}"
                                                    BorderBrush="{StaticResource BorderStrongBrush}"
                                                    BorderThickness="1.5"
                                                    CornerRadius="10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontFamily="{StaticResource MonoFont}"
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            Foreground="{StaticResource MutedBrush}"
                                                            Text="{Binding Letter}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Margin="10,0,0,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="14"
                                                            Text="{Binding Label}"
                                                            TextWrapping="Wrap" />
                                                        <TextBlock
                                                            x:Name="Mark"
                                                            Grid.Column="2"
                                                            VerticalAlignment="Center"
                                                            FontSize="13"
                                                            FontWeight="Bold"
                                                            Foreground="{StaticResource GreenBrush}"
                                                            Text="{Binding Mark}" />
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Correct">
                                                        <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource GreenBrush}" />
                                                        <Setter TargetName="Chrome" Property="Background" Value="{StaticResource GreenTintBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="WrongPick">
                                                        <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                                        <Setter TargetName="Chrome" Property="Background" Value="{StaticResource WrongTintBrush}" />
                                                        <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Dimmed">
                                                        <Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Visibility="{Binding Revealed, Converter={StaticResource BoolToVisibility}}">
                            <Border
                                Margin="0,7,0,0"
                                Padding="14,12"
                                Background="{StaticResource HeaderBrush}"
                                BorderBrush="{StaticResource BorderSoftBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="13.5"
                                        FontWeight="Bold"
                                        Text="{Binding Feedback}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FeedbackIsCorrect}" Value="False">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="12.5"
                                        Foreground="{StaticResource BodyBrush}"
                                        LineHeight="19.4"
                                        LineStackingStrategy="BlockLineHeight"
                                        Text="{Binding Why}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Button
                                Margin="0,15,0,0"
                                Padding="18,9"
                                HorizontalAlignment="Right"
                                Command="{Binding NextCommand}"
                                Content="{Binding NextLabel}"
                                FontSize="13"
                                Style="{StaticResource DarkButton}" />
                        </StackPanel>
                    </StackPanel>

                    <!--  Score  -->
                    <StackPanel Visibility="{Binding Finished, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            Margin="0,23,0,0"
                            HorizontalAlignment="Center"
                            FontFamily="{StaticResource MonoFont}"
                            FontSize="32"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource AccentBrush}"
                            Text="{Binding Score}" />
                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="14"
                            Foreground="{StaticResource BodyBrush}"
                            Text="{Binding ResultMessage}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <StackPanel
                            Margin="0,15,0,4"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <Button
                                Padding="18,9"
                                Command="{Binding RetryCommand}"
                                Content="다시 풀기"
                                Style="{StaticResource GhostButton}" />
                            <Button
                                Margin="10,0,0,0"
                                Padding="18,9"
                                Command="{Binding CloseCommand}"
                                Content="완료"
                                Style="{StaticResource AccentButton}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!--  Reading modal  -->
        <Grid
            Grid.RowSpan="2"
            Background="{StaticResource OverlayBrush}"
            Visibility="{Binding ActiveReading, Converter={StaticResource NotNullToVisibility}}">
            <Border
                Width="620"
                MaxHeight="740"
                Padding="24,22"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="16"
                DataContext="{Binding ActiveReading}">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="64"
                        Direction="270"
                        Opacity="0.4"
                        ShadowDepth="24"
                        Color="{StaticResource ShadowColor}" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Padding="8,3"
                            VerticalAlignment="Center"
                            Background="{StaticResource IndigoTintBrush}"
                            CornerRadius="6">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource IndigoBrush}"
                                Text="이론" />
                        </Border>
                        <TextBlock
                            Grid.Column="1"
                            Margin="10,0"
                            VerticalAlignment="Center"
                            FontSize="15"
                            FontWeight="Bold"
                            Text="{Binding Title}" />
                        <TextBlock
                            Grid.Column="2"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource MonoFont}"
                            FontSize="11"
                            Foreground="{StaticResource MutedBrush}"
                            Text="{Binding PageLabel}" />
                        <Button
                            Grid.Column="3"
                            AutomationProperties.Name="이론 닫기"
                            Command="{Binding CloseCommand}"
                            Style="{StaticResource CloseButton}" />
                    </Grid>

                    <ScrollViewer
                        Grid.Row="1"
                        Margin="0,14,0,0"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock
                                FontSize="18"
                                FontWeight="Bold"
                                LineHeight="25.2"
                                LineStackingStrategy="BlockLineHeight"
                                Text="{Binding PageTitle}"
                                TextWrapping="Wrap" />
                            <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Paragraphs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Margin="0,0,0,10"
                                            FontSize="13.5"
                                            Foreground="{StaticResource InkSoftBrush}"
                                            LineHeight="23"
                                            LineStackingStrategy="BlockLineHeight"
                                            Text="{Binding}"
                                            TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <controls:CodeBlock
                                Margin="0,4,0,0"
                                Code="{Binding Code}"
                                Visibility="{Binding HasSourceCode, Converter={StaticResource BoolToVisibility}}" />
                            <controls:CommandList
                                Margin="0,4,0,0"
                                Code="{Binding Code}"
                                Visibility="{Binding HasCommands, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Padding="16,9"
                            Command="{Binding PrevCommand}"
                            Content="← 이전">
                            <Button.Style>
                                <Style BasedOn="{StaticResource GhostButton}" TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PrevEnabled}" Value="False">
                                            <Setter Property="Opacity" Value="0.35" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button
                            Grid.Column="2"
                            Padding="18,9"
                            Command="{Binding NextCommand}"
                            Content="{Binding NextLabel}"
                            Style="{StaticResource AccentButton}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
